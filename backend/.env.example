NODE_ENV=development
PORT=3001
BIND_HOST=127.0.0.1
TZ=Asia/Jakarta

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=fw_dental
DB_SYNCHRONIZE=false

JWT_SECRET=
PUBLIC_APP_URL=http://localhost:3000

# Shared SMTP sender for password resets and notification emails.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Optional single staff inbox for new bookings and attendance reminders.
SMTP_NOTIFICATION_TO=

WEBHOOK_URL=http://127.0.0.1:3000/api/webhooks/notifications
NOTIFICATION_WEBHOOK_SECRET=
# Optional comma-separated trusted proxy IPs or CIDRs. Set only behind an ingress that replaces incoming X-Forwarded-For.
TRUSTED_PROXY_ADDRESSES=
